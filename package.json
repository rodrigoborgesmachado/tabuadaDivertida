  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc && vite build && node -e \"const fs=require('fs'); fs.copyFileSync('routes.json','build/routes.json');\"",
    "build:app": "tsc && vite build --mode app",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "app:sync": "npm run build:app && cap sync android",
    "app:open": "cap open android",
    "app:assets": "capacitor-assets generate --android --iconBackgroundColor \"#ffffff\" --iconBackgroundColorDark \"#ffffff\" --splashBackgroundColor \"#fff7d7\" --splashBackgroundColorDark \"#101c30\""
